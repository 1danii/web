---
import Layout from "@/layouts/layout.astro";
import TimelineRow from "@/components/timeline-row.astro";
import ProjectRow from "@/components/project-row.astro";
import HoverList from "@/components/hover-list.astro";
import RoughNotation from "@/components/rough-notation.astro";
import RoughStar from "@/components/rough-star.astro";
import { FrameCarousel } from "@/components/frame-carousel";
---

<Layout>
  <div class="flex flex-col gap-y-10">
    <section class="animate-fade-up-mount flex flex-col gap-y-0">
      <h1 class="text-base font-[450]">Daniel Pallares</h1>
      <p class="text-muted text-sm">
        web developer{" "}
        <RoughStar color="var(--color-primary)" delay={800} />{" "}
      </p>
    </section>
    <section class="animate-fade-up-mount fade-up-delay-1">
      <p class="text-sm text-pretty">
        Id et{" "}
        {/* <a
          href="#"
          class="decoration-muted hover:decoration-foreground ease underline decoration-dashed decoration-1 duration-200 [text-decoration-skip-ink:auto] [text-underline-position:from-font]"
          >Link github</a
        > */}
        {/* <a
          href="#"
          class="decoration-muted hover:decoration-foreground ease underline decoration-wavy decoration-1 duration-200 [text-decoration-skip-ink:auto] [text-underline-position:from-font]"
          >Link github</a
        > */}
        a{" "}
        <a href="#" class="link-dashed">
          {" "}
          Link github{" "}
        </a>{" "}
        id dolor id aute dolor reprehenderit quis{" "}
        <RoughNotation type="circle" color="var(--color-primary)">
          consequat
