---
import Layout from "@/layouts/layout.astro";
import TimelineRow from "@/components/timeline-row.astro";
import ProjectRow from "@/components/project-row.astro";
import HoverList from "@/components/hover-list.astro";
import RoughNotation from "@/components/rough-notation.astro";
import RoughStar from "@/components/rough-star.astro";
import ToolFan from "@/components/tool-fan.astro";
import { FrameCarousel } from "@/components/frame-carousel";
---

<Layout>
  <div class="flex flex-col gap-y-10">
    <section class="animate-fade-up-mount flex flex-col gap-y-0">
      <h1 class="text-base font-[450]">
        Daniel Pallares
        <RoughStar class="ml-1.5" color="var(--color-primary)" delay={800} />
      </h1>
      <p class="text-muted text-sm">web developer</p>
    </section>
    <section class="animate-fade-up-mount fade-up-delay-1 text-sm leading-normal text-pretty">
      <p>
        I'm a developer based in Prague, building web and mobile interfaces{" "}
        <RoughNotation
          type="underline"
          color="var(--color-primary)"
          padding={0}
        >
          with care
        </RoughNotation>{" "}
        for how they look and feel. I have experience working as a freelancer,
        on a product at a SaaS company, and on client projects at a web agency.
        <br />
        <br />
        My main stack is TypeScript and React, plus{" "}
        <ToolFan
          tools={[
            { name: "Next.js", icon: "nextjs", bg: "#000" },
            { name: "Astro", icon: "astro", bg: "#fff" },
            { name: "TanStack", icon: "tanstack", bg: "#fff" },
          ]}
        >
          frameworks and tools
        </ToolFan>{" "}
        around them. I also have some experience with Node.js backends, ORMs and
        CMSs. I spend time in{" "}
        <ToolFan
          tools={[
            { name: "Figma", icon: "figma", bg: "#fff" },
            { name: "Wonder", icon: "wonder", bg: "#000" },
          ]}
        >
          design tools
        </ToolFan>{" "}
        too, learning more of the design side.
      </p>
    </section>
    <section class="animate-fade-up-mount fade-up-delay-2">
      <ul role="list" class="grid grid-cols-[1fr_auto] gap-y-3">
        <TimelineRow
          logo="/companies/giant.svg"
          title="Giant interactive"
          start="2026-06"
        />
        <TimelineRow
          logo="/companies/brandcloud.svg"
          title="BrandCloud"
          start="2024-01"
          end="2026-05"
        />
      </ul>
    </section>
    <section class="animate-fade-up-mount fade-up-delay-3">
      <FrameCarousel client:idle />
    </section>
    <section class="animate-fade-up-mount fade-up-delay-4">
      <HoverList>
        <ProjectRow title="Lorem ipsum" href="#" />
        <ProjectRow title="Lorem ipsum" href="#" />
        <ProjectRow title="Lorem ipsum" href="#" />
      </HoverList>
    </section>
  </div>
</Layout>
