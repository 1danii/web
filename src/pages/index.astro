---
import Layout from "@/layouts/layout.astro";
import TimelineRow from "@/components/timeline-row.astro";
import ProjectRow from "@/components/project-row.astro";
import HoverList from "@/components/hover-list.astro";
import { FrameCarousel } from "@/components/frame-carousel";
---

<Layout>
  <div class="flex flex-col gap-y-10">
    <section class="animate-fade-up-mount flex flex-col gap-y-0.5">
      <h1 class="text-2xl font-medium">Daniel Pallares</h1>
      <p class="text-muted text-sm">web developer</p>
    </section>
    <section class="animate-fade-up-mount fade-up-delay-1">
      <p class="text-muted text-sm text-pretty">
        Id et id dolor id aute dolor reprehenderit quis consequat. Nostrud
        adipisicing ipsum eu ipsum excepteur. Occaecat irure exercitation
        commodo reprehenderit adipisicing est. Eiusmod nostrud consectetur
        commodo reprehenderit incididunt.
      </p>
    </section>
    <section
      class="animate-fade-up-mount fade-up-delay-2 flex flex-col gap-y-3"
    >
      <TimelineRow
        logo="/companies/brandcloud.svg"
        title="Lorem ipsum"
        year="2020"
      />
      <TimelineRow
        logo="/companies/brandcloud.svg"
        title="Lorem ipsum"
        year="2020"
      />
    </section>
    <section class="animate-fade-up-mount fade-up-delay-3">
      <FrameCarousel client:load />
    </section>
    <section class="animate-fade-up-mount fade-up-delay-4">
      <HoverList>
        <ProjectRow title="Lorem ipsum" href="#" />
        <ProjectRow title="Lorem ipsum" href="#" />
        <ProjectRow title="Lorem ipsum" href="#" />
      </HoverList>
    </section>
  </div>
</Layout>
