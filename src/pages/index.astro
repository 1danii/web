      </p>
    </section>
    <section class="animate-fade-up-mount fade-up-delay-2 grid grid-cols-[1fr_auto] gap-y-3">
      <TimelineRow
        logo="/companies/brandcloud.svg"
        title="Lorem ipsum"
        start="2020-09"
      />
      <TimelineRow
        logo="/companies/brandcloud.svg"
        title="Lorem ipsum"
        start="2029-09"
        end="2020-09"
      />
    </section>
    <section class="animate-fade-up-mount fade-up-delay-3">
      <FrameCarousel client:load />
    </section>
    <section class="animate-fade-up-mount fade-up-delay-4">
      <HoverList>
        <ProjectRow title="Lorem ipsum" href="#" />
        <ProjectRow title="Lorem ipsum" href="#" />
        <ProjectRow title="Lorem ipsum" href="#" />
      </HoverList>
    </section>
