---
import "./styles.css";
import { FadeInText } from "./_fade-in-text";
import HeroBg from "./hero-bg.png";
---

<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  </head>
  <body class="bg-primary text-primary-foreground font-sans antialiased">
    <header class="mx-auto max-w-5xl px-6">
      <div
        class="border-border flex h-16 items-center justify-between border-b"
      >
        <div class="flex items-center text-lg font-medium tracking-tight">
          <div class="bg-inverted mr-2 size-5"></div>
          Brandly
        </div>
        <div>
          <a
            href=""
            class="bg-brand text-inverted-foreground hover:bg-brand-hover inline-flex h-8 items-center justify-center rounded-full px-3 text-center text-sm font-medium whitespace-nowrap transition-colors duration-50 ease-linear"
          >
            Log In
          </a>
        </div>
      </div>
    </header>

    <div class="relative">
      <section class="mx-auto max-w-5xl px-6 pt-28">
        <div class="flex flex-col items-start">
          <a
            href=""
            data-motion-element="changelog-link"
            style="filter: blur(8px); opacity: 0; transform: translateY(20%);"
            class="bg-accent text-accent-foreground hover:bg-accent-hover mb-8 flex h-6 items-center justify-center rounded-full pr-2 pl-0.5 text-xs whitespace-nowrap transition-colors duration-100 ease-linear"
          >
            <div
              class="bg-brand text-inverted-foreground mr-1.5 flex h-5 items-center justify-center rounded-full px-1.5 text-[0.5rem] leading-none font-medium"
            >
              NEW
            </div>
            Check out the changelog
            <svg
              class="text-gray-8 ml-1 size-3"
              viewBox="0 0 15 15"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M8.14645 3.14645C8.34171 2.95118 8.65829 2.95118 8.85355 3.14645L12.8536 7.14645C13.0488 7.34171 13.0488 7.65829 12.8536 7.85355L8.85355 11.8536C8.65829 12.0488 8.34171 12.0488 8.14645 11.8536C7.95118 11.6583 7.95118 11.3417 8.14645 11.1464L11.2929 8H2.5C2.22386 8 2 7.77614 2 7.5C2 7.22386 2.22386 7 2.5 7H11.2929L8.14645 3.85355C7.95118 3.65829 7.95118 3.34171 8.14645 3.14645Z"
                fill="currentColor"
                fill-rule="evenodd"
                clip-rule="evenodd"></path></svg
            >
          </a>
          <h1
            class="text-5xl leading-[1.1] font-medium tracking-tighter text-balance"
          >
            <FadeInText client:load text="Lorem ipsum tempor," />
            <br />
            <FadeInText client:load text="aliqua eiusmod esse" />
          </h1>
          <a
            href=""
            data-motion-element="get-started-link"
            style="filter: blur(8px); opacity: 0; transform: translateY(20%);"
            class="bg-inverted text-inverted-foreground hover:bg-gray-12/90 mt-8 inline-flex h-10 items-center justify-center rounded-full px-4 text-center text-sm font-medium whitespace-nowrap transition-colors duration-50 ease-linear"
          >
            Get Started
          </a>

          <div
            data-motion-element="hero-preview"
            style="opacity: 0;"
            class="border-border mt-20 aspect-video w-full rounded-2xl border bg-white/50 p-1"
          >
            <div class="border-border size-full rounded-xl border bg-white">
            </div>
          </div>
        </div>
      </section>

      <div
        data-motion-element="hero-background"
        style={{
          backgroundImage: `url("${HeroBg.src}")`,
          opacity: 0,
          transform: "translateY(4px)",
        }}
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 mt-52 h-dvh overflow-hidden mask-x-from-70% mask-x-to-98% mask-b-from-65% mask-b-to-90% bg-size-[100%_auto] bg-bottom bg-no-repeat filter-[url(#blur)]"
      >
        <div
          style={{ maskImage: `url("${HeroBg.src}")` }}
          class="bg-brand absolute inset-0 mask-[100%_auto] mask-bottom mask-no-repeat mix-blend-color"
        >
        </div>
      </div>
      <!-- <svg width="1" height="1">
        <defs>
          <filter id="blur" x="-20%" y="-20%" width="140%" height="140%">
            <feConvolveMatrix
              in="SourceGraphic"
              divisor={100}
              edgeMode="duplicate"
              kernelMatrix={Array.from({ length: 64 }, () => 1).join(" ")}
              order="64 1"></feConvolveMatrix>
          </filter>
        </defs>
      </svg> -->
    </div>

    <script>
      import { animate } from "motion";

      animate(
        '[data-motion-element="changelog-link"]',
        { filter: "blur(0px)", opacity: 1, y: "0%" },
        { delay: 1.6, duration: 0.5, ease: "easeOut" }
      );

      animate(
        '[data-motion-element="get-started-link"]',
        { filter: "blur(0px)", opacity: 1, y: "0%" },
        { delay: 0.3, duration: 0.5, ease: "easeOut" }
      );

      animate(
        '[data-motion-element="hero-preview"]',
        { opacity: 1 },
        { delay: 0.6, duration: 0.5, ease: "easeOut" }
      );

      animate(
        '[data-motion-element="hero-background"]',
        { opacity: 0.8, y: "0px" },
        { delay: 1, duration: 0.5, ease: "easeOut" }
      );
    </script>
  </body>
</html>
