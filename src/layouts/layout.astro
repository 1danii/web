---
import { ContactLink } from "@/components/contact-link";
import Posthog from "@/components/posthog.astro";
import "../globals.css";
import { Font } from "astro:assets";
import { GitHubLogoIcon, LinkedInLogoIcon } from "@radix-ui/react-icons";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Daniel Pallares",
  url: new URL("/", Astro.site),
  sameAs: ["https://www.linkedin.com/in/dani-pallares/"],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:title" content="Daniel Pallares" />
    <meta property="og:description" content="web developer" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/og.png", Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <title>Daniel Pallares</title>
    <link rel="canonical" href={Astro.url} />
    <meta name="theme-color" content="#fcfcfc" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content="web developer" />
    <Font cssVariable="--font-inter" preload />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <Posthog />
  </head>
  <body class="bg-background text-foreground flex min-h-dvh flex-col overflow-x-clip">
    <main class="container w-full flex-1 pt-24">
      <slot />
    </main>
    <footer class="text-muted container flex w-full items-center justify-between pt-16 pb-8 text-sm">
      <div class="flex items-center gap-x-3">
        <a
          href="https://github.com/1danii"
          target="_blank"
          aria-label="GitHub"
          class="hover:text-foreground -m-1.5 p-1.5 transition-colors duration-200 ease-[ease]"
        >
          <GitHubLogoIcon className="size-4" />
        </a>
        <a
          href="https://www.linkedin.com/in/dani-pallares/"
          target="_blank"
          aria-label="LinkedIn"
          class="hover:text-foreground -m-1.5 p-1.5 transition-colors duration-200 ease-[ease]"
        >
          <LinkedInLogoIcon className="size-4" />
        </a>
      </div>
      <ContactLink client:idle />
    </footer>
  </body>
</html>
