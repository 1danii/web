---
import Posthog from "@/components/posthog.astro";
import "../globals.css";
import { Font } from "astro:assets";
import { GitHubLogoIcon, LinkedInLogoIcon } from "@radix-ui/react-icons";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:title" content="Daniel Pallares" />
    <meta property="og:description" content="web developer" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <title>Daniel Pallares</title>
    <meta name="description" content="web developer" />
    <Font cssVariable="--font-inter" preload />
    <Posthog />
  </head>
  <body class="bg-background text-foreground overflow-x-clip">
    <main class="container flex min-h-dvh flex-col pt-24">
      <slot />
      <footer
        class="mt-auto flex items-center justify-between pt-16 pb-8 text-sm text-(--color-gray-9)"
      >
        <div class="flex items-center gap-x-3">
          <a
            href="https://github.com/1danii"
            target="_blank"
            aria-label="GitHub"
            class="hover:text-foreground transition-colors duration-200 ease-[ease]"
          >
            <GitHubLogoIcon className="size-4" />
          </a>
          <a
            href="https://www.linkedin.com/in/dani-pallares/"
            target="_blank"
            aria-label="LinkedIn"
            class="hover:text-foreground transition-colors duration-200 ease-[ease]"
          >
            <LinkedInLogoIcon className="size-4" />
          </a>
        </div>
        <a
          href="mailto:danielpallares@email.cz"
          class="hover:text-foreground transition-colors duration-200 ease-[ease]"
        >
          contact
        </a>
      </footer>
    </main>
  </body>
</html>
