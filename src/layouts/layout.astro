---
import { ContactLink } from "@/components/contact-link";
import Posthog from "@/components/posthog.astro";
import "../globals.css";
import { Font } from "astro:assets";
import { GitHubLogoIcon, LinkedInLogoIcon } from "@radix-ui/react-icons";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:title" content="Daniel Pallares" />
    <meta property="og:description" content="web developer" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/og.png", Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <title>Daniel Pallares</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content="web developer" />
    <Font cssVariable="--font-inter" preload />
    <Posthog />
  </head>
  <body class="bg-background text-foreground overflow-x-clip">
    <main class="container flex min-h-dvh flex-col pt-24">
      <slot />
      <footer class="text-muted mt-auto flex items-center justify-between pt-16 pb-8 text-sm">
        <div class="flex items-center gap-x-3">
          <a
            href="https://github.com/1danii"
            target="_blank"
            aria-label="GitHub"
            class="hover:text-foreground transition-colors duration-200 ease-[ease]"
          >
            <GitHubLogoIcon className="size-4" />
          </a>
          <a
            href="https://www.linkedin.com/in/dani-pallares/"
            target="_blank"
            aria-label="LinkedIn"
            class="hover:text-foreground transition-colors duration-200 ease-[ease]"
          >
            <LinkedInLogoIcon className="size-4" />
          </a>
        </div>
        <ContactLink client:load />
      </footer>
    </main>
  </body>
</html>
