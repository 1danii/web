---
import { ChevronRightIcon } from "@radix-ui/react-icons";

interface Props {
  title: string;
  href: string;
}

const { title, href } = Astro.props;
---

<a
  {href}
  data-hover-item
  class="relative flex h-9 items-center gap-x-3 px-3 text-sm"
>
  <span class="line-clamp-1 min-w-0">{title}</span>
  <div class="flex flex-1 items-center gap-x-1.5">
    <div class="bg-border-transparent h-px flex-1"></div>
    <ChevronRightIcon className="text-muted -mr-1 size-4 shrink-0" />
  </div>
</a>
