---
import Tooltip from "./tooltip.astro";

/*
 * A phrase in running text with a small fan of tool logos in front of it. Hovering the logos or the
 * phrase lifts the cards out and grows them. Ported from the folder snack (src/pages/snacks/folder,
 * icons-only inline variant) with its DialKit values baked in.
 */
interface Props {
  /** Two or three logos, left to right. Two fill the left and right cards. */
  tools: [Tool, Tool] | [Tool, Tool, Tool];
}

interface Tool {
  /** Shown to screen readers, e.g. "Next.js". */
  name: string;
  /** File in /public/tools without .svg. */
  icon: string;
  /** Card background, chosen per logo. */
  bg: "#fff" | "#000";
}

const { tools } = Astro.props;

/*
 * Sizes: a resting card is 12px (as tool-icon.astro), an open one 32px, and open cards fly 1.6× as far
 * as designed. The layout below is in the snack's design units (hundredths of its 512px frame, where a
 * card is 33.2), converted to px with U.
 */
const CARD = 12;
const OPEN = 32;
const LIFT = 1.6;
const U = CARD / 33.2;
const HALF = 16.6;
const K = OPEN / CARD;

/*
 * Resting position (x, y = top-left corner) and tilt, then the extra move and turn when open. The
 * last card sits on top.
 */
interface Card {
  name: "left" | "center" | "right";
  x: number;
  y: number;
  rotate: number;
  lift: { x: number; y: number; rotate: number };
  tool: Tool;
}

const cards: Card[] =
  tools.length === 3
    ? [
        { name: "left", x: 16.41, y: 7.81, rotate: -18, lift: { x: -5.08, y: -18.75, rotate: -9 }, tool: tools[0] },
        { name: "right", x: 50.39, y: 5.47, rotate: 14, lift: { x: 5.08, y: -21.09, rotate: 9 }, tool: tools[2] },
        { name: "center", x: 33.4, y: 2.73, rotate: -2, lift: { x: 0, y: -25.78, rotate: 2 }, tool: tools[1] },
      ]
    : // Two logos: closer than the three-card fan's outer pair so they just touch, centred on the same spot.
      [
        { name: "left", x: 20.66, y: 7, rotate: -14, lift: { x: -3, y: -21, rotate: -6 }, tool: tools[0] },
        { name: "right", x: 46.15, y: 5, rotate: 11, lift: { x: 3, y: -23, rotate: 6 }, tool: tools[1] },
      ];

// Half the width (and height) of a square tilted by `deg`: how far it reaches from its centre.
const reach = (half: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return half * (Math.abs(Math.cos(a)) + Math.abs(Math.sin(a)));
};

// The resting group's bounds. The stage is exactly this wide, with zero height at its middle.
const centres = cards.map((card) => ({ x: card.x + HALF, y: card.y + HALF, r: reach(HALF, card.rotate) }));
const left = Math.min(...centres.map((c) => c.x - c.r));
const right = Math.max(...centres.map((c) => c.x + c.r));
const middle = (Math.min(...centres.map((c) => c.y - c.r)) + Math.max(...centres.map((c) => c.y + c.r))) / 2;
const stageWidth = (right - left) * U;

/*
 * Opening grows the whole fan by K around an anchor near its bottom centre: each card moves by its
 * lift (×1.6, growing with the card) and away from the anchor by (K - 1) × its offset from it.
 */
const anchor = { x: 50, y: 11 };
const px = (n: number) => `${n.toFixed(2)}px`;
const style = (card: Card, i: number) => {
  const c = centres[i];
  const openRotate = card.rotate + card.lift.rotate;
  return [
    `left: ${px((c.x - left) * U - OPEN / 2)}`,
    `top: ${px((c.y - middle) * U - OPEN / 2)}`,
    `--r: ${card.rotate}deg`,
    `--open-x: ${px((card.lift.x * LIFT * K + (c.x - anchor.x) * (K - 1)) * U)}`,
    `--open-y: ${px((card.lift.y * LIFT * K + (c.y - anchor.y) * (K - 1)) * U)}`,
    `--open-r: ${openRotate}deg`,
    // Half the open, tilted card's height: how far above its centre the tooltip must sit.
    `--tip-reach: ${px(reach(OPEN / 2, openRotate))}`,
    `--bg: ${card.tool.bg}`,
  ].join("; ");
};

// The logos are decorative; screen readers get the names after the phrase: "… (Next.js, Astro and TanStack)".
const names = tools.map((t) => t.name);
const spoken = `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;

// Trimmed so the only space between the logos and the phrase is the 2px gap after the stage.
const phrase = (await Astro.slots.render("default")).trim();
---

<span class="tool-fan"
  ><span class="stage" style={`width: ${px(stageWidth)}`} aria-hidden="true"
    >{
        cards.map((card, i) => (
          <span class="card" data-card={card.name} style={style(card, i)}>
            <img src={`/tools/${card.tool.icon}.svg`} alt="" draggable="false" />
            {/* Screen readers already get the names after the phrase. */}
            <span class="tip" aria-hidden="true">
              <Tooltip>{card.tool.name}</Tooltip>
            </span>
          </span>
        ))
      }</span
  ><Fragment set:html={phrase} /><span class="sr-only"> ({spoken})</span></span
>

<script>
  /*
   * Tooltip timing, like Base UI's Tooltip.Provider:
   * - data-settled on the fan once every card's opening transition has finished, cleared on leave.
   * - data-instant on a card entered within 400ms of leaving another card's shown tooltip, so moving
   *   along the fan swaps tooltips without fading each one in again.
   */
  const INSTANT_TIMEOUT = 400;

  for (const fan of document.querySelectorAll<HTMLElement>(".tool-fan")) {
    const cards = [...fan.querySelectorAll<HTMLElement>(".card")];
    let opening = 0;
    let lastTipClosed = -Infinity;

    fan.addEventListener("pointerenter", () => {
      const run = ++opening;
      // Next frame, so the :hover transitions have started. With reduced motion there are none.
      requestAnimationFrame(() => {
        const transitions = cards.flatMap((card) => card.getAnimations());
        Promise.all(transitions.map((t) => t.finished)).then(
          () => {
            if (run === opening) fan.dataset.settled = "";
          },
          () => {}, // Interrupted by leaving; the next enter starts over.
        );
      });
    });

    fan.addEventListener("pointerleave", () => {
      opening++;
      lastTipClosed = -Infinity;
      delete fan.dataset.settled;
    });

    for (const card of cards) {
      card.addEventListener("pointerenter", () => {
        const recent = performance.now() - lastTipClosed < INSTANT_TIMEOUT;
        card.toggleAttribute("data-instant", recent);
      });
      card.addEventListener("pointerleave", () => {
        // Removed now, so this tooltip still fades out normally.
        card.removeAttribute("data-instant");
        if ("settled" in fan.dataset) lastTipClosed = performance.now();
      });
    }
  }
</script>

<style>
  .tool-fan {
    --ease-out: cubic-bezier(0.215, 0.61, 0.355, 1);
    /* Spring (stiffness 151, damping 19, mass 1.2) sampled into linear(), lasting 858ms. */
    --spring: linear(
      0, 0.0087, 0.025, 0.0476, 0.0756, 0.1079, 0.1438, 0.1824, 0.2231, 0.2652, 0.3082, 0.3515, 0.3948,
      0.4376, 0.4798, 0.5209, 0.5608, 0.5992, 0.6361, 0.6713, 0.7047, 0.7363, 0.766, 0.7939, 0.8199,
      0.844, 0.8663, 0.8868, 0.9056, 0.9228, 0.9383, 0.9524, 0.965, 0.9763, 0.9862, 0.995, 1.0027,
      1.0093, 1.015, 1.0198, 1.0238, 1.027, 1.0296, 1.0316, 1.0331, 1.034, 1.0346, 1.0347, 1.0346,
      1.0341, 1.0335, 1.0326, 1.0315, 1.0304, 1.0291, 1.0277, 1.0262, 1.0248, 1.0233, 1.0218, 1.0203,
      1.0188, 1.0173, 1.0159, 1.0146, 1.0133, 1.012, 1.0108, 1.0097, 1.0086, 1.0076, 1.0067, 1.0058,
      1.005, 1.0043, 1.0036, 1.003, 1.0024, 1.0019, 1.0014, 1.001, 1.0006, 1.0003, 1, 0.9998, 0.9996,
      0.9994, 0.9992, 0.9991, 0.999, 0.9989, 0.9989, 0.9988, 0.9988, 0.9988, 0.9988, 0.9988, 0.9988,
      0.9989, 0.9989, 0.9989, 0.999, 1
    );
    --spring-duration: 858ms;

    white-space: nowrap;
  }

  /*
   * As wide as the resting cards and zero high, so like an image in running text it takes their width
   * in the line but never grows the line box. vertical-align: middle centres the cards on the line.
   */
  .stage {
    position: relative;
    display: inline-block;
    vertical-align: middle;
    margin-right: 2px;
  }

  /* Keep the grown cards above the surrounding text. */
  .tool-fan:hover .stage {
    z-index: 1;
  }

  /*
   * Once open, a static invisible box around the whole fan keeps it hovered while the cursor crosses
   * the gaps between cards. It only catches the pointer while open. 3.5 × 3 open cards, mostly above.
   */
  .stage::before {
    content: "";
    position: absolute;
    left: calc(50% - 56px);
    top: -64px;
    width: 112px;
    height: 96px;
    pointer-events: none;
  }

  .tool-fan:hover .stage::before {
    pointer-events: auto;
  }

  /*
   * Card: laid out at its open size and scaled down to 12px at rest (12 / 32), so the logo is
   * rasterised at full resolution and stays sharp while growing. The radius and shadow are the
   * Wonder design's (36px radius on 170px; shadow-lg with +2px spread on 230px) at 32px.
   */
  .card {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6.78px;
    background: var(--bg);
    box-shadow:
      0 1.39px 2.09px 0.28px rgb(0 0 0 / 0.1),
      0 0.56px 0.83px -0.56px rgb(0 0 0 / 0.1);

    translate: 0 0;
    rotate: var(--r);
    scale: 0.375;

    /* Closing: one plain ease-out, the opening order reversed with the same gaps. */
    transition-property: translate, rotate, scale;
    transition-duration: 400ms;
    transition-timing-function: var(--ease-out);
  }

  .card img {
    width: 64%;
    height: 64%;
    object-fit: contain;
    user-select: none;
  }

  /*
   * The hovered card comes to the front so its tooltip isn't covered by its neighbours, but only once
   * the fan has finished opening (as the tooltip), so cards don't jump in front of each other mid-flight.
   */
  .tool-fan[data-settled] .card:hover {
    z-index: 1;
  }

  /*
   * Tooltip with the tool's name above the hovered open card, upright whatever the card's tilt. Its
   * corner sits on the card's centre: it turns back by the open tilt around that point, then moves up
   * by half the tilted card's height (--tip-reach) plus a 4px gap, like the email tooltip's offset.
   */
  .tip {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-origin: 0 0;
    transform: rotate(calc(-1 * var(--open-r))) translate(-50%, calc(-100% - var(--tip-reach) - 4px));
    pointer-events: none;
  }

  /* The bubble (tooltip.astro) fades and grows with the shared tooltip motion. */
  .tip > :global(*) {
    opacity: 0;
    scale: 0.97;
  }

  /*
   * It shows only once the fan has finished opening (data-settled, set by the script above). Until
   * then the card is still turning and the tooltip, straightened for the final angle, would sit crooked.
   */
  .tool-fan[data-settled] .card:hover .tip > :global(*) {
    opacity: 1;
    scale: 1;
  }

  /* Hidden at once when the fan closes, and shown at once when moving straight from another card. */
  .tool-fan:not([data-settled]) .tip > :global(*),
  .card[data-instant] .tip > :global(*) {
    transition-duration: 0ms;
  }

  [data-card="right"] {
    transition-delay: 0ms;
  }

  [data-card="left"] {
    transition-delay: 40ms;
  }

  [data-card="center"] {
    transition-delay: 80ms;
  }

  /* Opening: spring, centre first. */
  .tool-fan:hover .card {
    translate: var(--open-x) var(--open-y);
    rotate: var(--open-r);
    scale: 1;
    transition-duration: var(--spring-duration);
    transition-timing-function: var(--spring);
  }

  .tool-fan:hover [data-card="left"] {
    transition-delay: 70ms;
  }

  .tool-fan:hover [data-card="center"] {
    transition-delay: 30ms;
  }

  .tool-fan:hover [data-card="right"] {
    transition-delay: 110ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .tool-fan:hover .card {
      transition-duration: 0ms;
      transition-delay: 0ms;
    }
  }
</style>
